[Unit]
# KernelGuard daemon — Week 4 packaging target.
# NOT wired up yet: this is a placeholder for the systemd packaging task
# in docs/ROADMAP.md. The controller does not currently support running
# as a long-lived daemon (it's invoked per-script via the CLI).
Description=KernelGuard eBPF runtime security daemon
After=network.target

[Service]
Type=simple
# TODO (Week 4): point at a daemonized entrypoint, e.g. controller/daemon.py
ExecStart=/usr/bin/python3 /opt/kernelguard/controller/bpf_loader.py
Restart=on-failure
# TODO (Week 4): ensure kernel hooks (kprobes/perf buffers) are detached
# cleanly on SIGTERM — add a signal handler in the daemon entrypoint.

[Install]
WantedBy=multi-user.target
